<div metal:use-macro="load: ../shared/_layout.pt">
    <div metal:fill-slot="content" tal:omit-tag="True">

        <div class="section content">

            <!-- Header -->
            <div
                class="is-flex is-flex-direction-column is-flex-direction-row-tablet is-justify-content-space-between is-align-items-flex-start mb-4">
                <div class="mb-3">
                    <h1 class="title is-size-3-mobile">Monitoring Record</h1>
                    <p tal:condition="management_unit" class="subtitle is-6 has-text-grey">
                        ${management_unit.name}
                        <span tal:condition="management_unit.variety"> &mdash; ${management_unit.variety.name}</span>
                    </p>
                </div>
                <div class="buttons">
                    <a href="#" onclick="history.back(); return false;" class="button is-light">
                        <span class="icon"><i class="fas fa-arrow-left"></i></span>
                        <span>Back</span>
                    </a>
                </div>
            </div>

            <form tal:condition="management_unit" action="/monitoring/new" method="post">
                <input type="hidden" name="management_unit_id" value="${management_unit.id}" />

                <!-- Visit details -->
                <div class="box">
                    <div class="columns is-multiline">
                        <div class="column is-12-mobile is-4-tablet">
                            <div class="field">
                                <label class="label">Monitoring Date</label>
                                <div class="control">
                                    <input class="input" type="date" name="monitoring_date"
                                        value="${monitoring_date.isoformat() if monitoring_date else ''}" required />
                                </div>
                            </div>
                        </div>

                        <div class="column is-12-mobile is-4-tablet">
                            <div class="field">
                                <label class="label">Growth Stage <span
                                        class="has-text-grey is-size-7">(optional)</span></label>
                                <div class="control">
                                    <div class="select is-fullwidth">
                                        <select name="growth_stage_id">
                                            <option value="">&mdash;</option>
                                            <option tal:repeat="stage growth_stages" value="${stage.id}">${stage}
                                            </option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Diseases -->
                <div class="box">
                    <details class="mb-2">
                        <summary class="title is-5" style="cursor: pointer;">Diseases</summary>

                        <div tal:repeat="section disease_sections" class="mt-4">
                            <details open="">
                                <summary class="title is-6" style="cursor: pointer;">${section['heading']}</summary>

                                <table class="table is-fullwidth is-size-7 mt-2">
                                    <thead>
                                        <tr>
                                            <th>Symptom</th>
                                            <th>Presence</th>
                                            <th>Severity</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr tal:repeat="field section['fields']">
                                            <td class="is-vcentered">${field['label']}</td>
                                            <td>
                                                <input type="hidden" name="disease_targets"
                                                    value="${field['target'].value}" />
                                                <div class="select is-small is-fullwidth">
                                                    <select name="disease_presence">
                                                        <option value="">&mdash;</option>
                                                        <option tal:repeat="p presence_options" value="${p.value}">
                                                            ${p.value}</option>
                                                    </select>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="select is-small is-fullwidth">
                                                    <select name="disease_severity">
                                                        <option value="">&mdash;</option>
                                                        <option tal:repeat="s severity_options" value="${s.value}">
                                                            ${s.value}</option>
                                                    </select>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </details>
                        </div>

                    </details>
                    <p class="help">
                        Leave Presence and Severity blank for anything not observed &mdash; only rows with both filled
                        in are
                        recorded.
                    </p>
                </div>

                <div class="field">
                    <div class="control">
                        <button type="submit" class="button is-primary">
                            <span class="icon"><i class="fas fa-check"></i></span>
                            <span>Save Monitoring Record</span>
                        </button>
                        <a href="#" onclick="history.back(); return false;" class="button is-light ml-2">Cancel</a>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>