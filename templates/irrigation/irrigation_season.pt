<div metal:use-macro="load: ../shared/_layout.pt">
  <div metal:fill-slot="content" tal:omit-tag="True">

    <style>
      .schedule-cell {
        white-space: nowrap;
      }

      .mu-row-name {
        font-weight: 600;
      }

      /* Mobile irrigation cards */
      @media screen and (max-width: 768px) {
        .irrigation-mu-card {
          background: hsl(0, 0%, 21%);
          border: 1px solid hsl(0, 0%, 29%);
          border-left: 4px solid hsl(141, 53%, 53%);
          border-radius: 6px;
          padding: 1rem;
          margin-bottom: 0.75rem;
        }

        .irrigation-mu-card.no-schedule {
          border-left-color: hsl(0, 0%, 48%);
        }

        .irrigation-mu-card.zero-schedule {
          border-left-color: hsl(48, 100%, 67%);
        }

        .irrigation-label {
          font-size: 0.75rem;
          font-weight: 600;
          color: hsl(0, 0%, 71%);
          text-transform: uppercase;
          letter-spacing: 0.05em;
        }

        .irrigation-value {
          color: hsl(0, 0%, 96%);
        }
      }
    </style>

    <div class="section content">

      <!-- Header -->
      <div
        class="is-flex is-flex-direction-column is-flex-direction-row-tablet is-justify-content-space-between is-align-items-flex-start mb-4">
        <div class="mb-3">
          <h1 class="title is-size-3-mobile">Irrigation Planner</h1>
          <p tal:condition="current_irrigation_season" class="subtitle is-6 has-text-grey">
            ${current_irrigation_season.name}
          </p>
        </div>
        <div class="buttons">
          <a href="/irrigation/" class="button is-light is-small">
            <span class="icon"><i class="fas fa-calendar-alt"></i></span>
            <span>Seasons</span>
          </a>
          <a href="/irrigation/program/" class="button is-info is-small">
            <span class="icon"><i class="fas fa-sliders-h"></i></span>
            <span>Program</span>
          </a>
        </div>
      </div>

      <!-- No season warning -->
      <div tal:condition="not current_irrigation_season" class="notification is-warning">
        <span class="icon"><i class="fas fa-exclamation-triangle"></i></span>
        No active irrigation season. <a href="/irrigation/">Create one.</a>
      </div>

      <!-- No vineyards -->
      <div tal:condition="current_irrigation_season and not vineyard_groups" class="notification is-light">
        No active management units found.
      </div>

      <!-- Vineyard groups -->
      <div tal:condition="vineyard_groups">
        <div tal:repeat="group vineyard_groups">

          <!-- Collapsible vineyard section -->
          <details class="details box mb-4" open="open">
            <summary class="summary p-3 is-clickable">
              <div class="level is-mobile">
                <div class="level-left">
                  <div class="level-item">
                    <strong class="is-size-5 is-size-6-mobile">${group.vineyard.name}</strong>
                  </div>
                  <div class="level-item">
                    <span tal:condition="group.has_any_active_schedules" class="tag is-success is-light ml-2">
                      Scheduled
                    </span>
                    <span tal:condition="not group.has_any_active_schedules" class="tag is-light ml-2">
                      No schedules
                    </span>
                  </div>
                </div>
                <div class="level-right">
                  <div class="level-item">
                    <span class="icon">
                      <i class="fas fa-chevron-down"></i>
                    </span>
                  </div>
                </div>
              </div>
            </summary>

            <!-- Desktop table -->
            <div class="desktop-only mt-3">
              <table class="table is-fullwidth is-striped is-hoverable">
                <thead>
                  <tr>
                    <th>Block</th>
                    <th>Variety</th>
                    <th>Area (ha)</th>
                    <th>Schedule</th>
                    <th>Effective From</th>
                    <th>Notes</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <tr tal:repeat="row group.rows">
                    <td class="mu-row-name">
                      <a href="/irrigation/block/${row.management_unit.id}/">
                        ${row.management_unit.name}
                      </a>
                    </td>
                    <td>
                      <span tal:condition="row.management_unit.variety">
                        ${row.management_unit.variety.name}
                      </span>
                      <span tal:condition="not row.management_unit.variety" class="has-text-grey">
                        —
                      </span>
                    </td>
                    <td>${row.management_unit.area}</td>

                    <!-- Active schedule cell -->
                    <td class="schedule-cell">
                      <span tal:condition="row.is_irrigated" class="tag is-success is-light">
                        ${row.active_schedule.schedule_summary}
                      </span>
                      <span tal:condition="row.has_active_schedule and not row.is_irrigated"
                        class="tag is-warning is-light">
                        No irrigation
                      </span>
                      <span tal:condition="not row.has_active_schedule" class="tag is-light has-text-grey">
                        Not set
                      </span>
                    </td>

                    <td>
                      <span tal:condition="row.active_schedule" class="is-size-7 has-text-grey">
                        ${row.active_schedule.effective_from.strftime('%d/%m/%Y')}
                      </span>
                      <span tal:condition="not row.active_schedule">—</span>
                    </td>

                    <td>
                      <span tal:condition="row.active_schedule and row.active_schedule.notes"
                        class="is-size-7 is-italic has-text-grey">
                        ${row.active_schedule.notes}
                      </span>
                    </td>

                    <td>
                      <div class="buttons are-small">
                        <!-- Block detail -->
                        <a href="/irrigation/block/${row.management_unit.id}/" class="button is-light is-outlined"
                          title="Block detail &amp; history">
                          <span class="icon"><i class="fas fa-chart-bar"></i></span>
                          <span>Block Details</span>
                        </a>

                        <!-- Add new schedule -->
                        <a href="/irrigation/schedule/new?management_unit_id=${row.management_unit.id}"
                          class="button is-primary is-outlined">
                          <span class="icon"><i class="fas fa-plus"></i></span>
                          <span>${'Change' if row.has_active_schedule else 'Set'}</span>
                        </a>

                        <!-- Edit existing schedule (correction) -->
                        <a tal:condition="row.active_schedule"
                          href="/irrigation/schedule/${row.active_schedule.id}/edit" class="button is-info is-outlined">
                          <span class="icon"><i class="fas fa-pencil-alt"></i></span>
                          <span>Edit</span>
                        </a>

                        <!-- Close schedule (turn off) -->
                        <button tal:condition="row.active_schedule and row.is_irrigated"
                          class="button is-danger is-outlined"
                          onclick="document.getElementById('close-modal-${row.active_schedule.id}').classList.add('is-active')">
                          <span class="icon"><i class="fas fa-stop-circle"></i></span>
                          <span>Turn off</span>
                        </button>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Mobile cards -->
            <div class="mobile-only mt-3">
              <div tal:repeat="row group.rows"
                tal:attributes="class python:'irrigation-mu-card' + (' no-schedule' if not row.has_active_schedule else ' zero-schedule' if not row.is_irrigated else '')">

                <div class="is-flex is-justify-content-space-between is-align-items-flex-start mb-2">
                  <div>
                    <div class="has-text-weight-semibold">
                      <a href="/irrigation/block/${row.management_unit.id}/">
                        ${row.management_unit.name}
                      </a>
                    </div>
                    <div class="is-size-7 has-text-grey">
                      <span tal:condition="row.management_unit.variety">${row.management_unit.variety.name}</span>
                      <span tal:condition="not row.management_unit.variety">No variety</span>
                      &mdash; ${row.management_unit.area} ha
                    </div>
                  </div>
                  <div>
                    <span tal:condition="row.is_irrigated" class="tag is-success is-light is-small">
                      ${row.active_schedule.schedule_summary}
                    </span>
                    <span tal:condition="row.has_active_schedule and not row.is_irrigated"
                      class="tag is-warning is-light is-small">
                      No irrigation
                    </span>
                    <span tal:condition="not row.has_active_schedule" class="tag is-light is-small">
                      Not set
                    </span>
                  </div>
                </div>

                <div tal:condition="row.active_schedule" class="mb-2">
                  <span class="irrigation-label">From </span>
                  <span class="irrigation-value is-size-7">
                    ${row.active_schedule.effective_from.strftime('%d/%m/%Y')}
                  </span>
                  <span tal:condition="row.active_schedule.notes" class="is-size-7 is-italic has-text-grey ml-2">
                    — ${row.active_schedule.notes}
                  </span>
                </div>

                <div class="buttons are-small mt-2">
                  <!-- Block detail -->
                  <a href="/irrigation/block/${row.management_unit.id}/" class="button is-light is-outlined is-small"
                    title="Block detail">
                    <span class="icon"><i class="fas fa-chart-bar"></i></span>
                  </a>

                  <!-- Add new schedule -->
                  <a href="/irrigation/schedule/new?management_unit_id=${row.management_unit.id}"
                    class="button is-primary is-outlined is-small">
                    <span class="icon"><i class="fas fa-plus"></i></span>
                    <span>${'Change' if row.has_active_schedule else 'Set'}</span>
                  </a>

                  <!-- Edit existing schedule (correction) -->
                  <a tal:condition="row.active_schedule" href="/irrigation/schedule/${row.active_schedule.id}/edit"
                    class="button is-info is-outlined is-small">
                    <span class="icon"><i class="fas fa-pencil-alt"></i></span>
                    <span>Edit</span>
                  </a>

                  <!-- Close schedule (turn off) -->
                  <button tal:condition="row.active_schedule and row.is_irrigated"
                    class="button is-danger is-outlined is-small"
                    onclick="document.getElementById('close-modal-${row.active_schedule.id}').classList.add('is-active')">
                    <span class="icon"><i class="fas fa-stop-circle"></i></span>
                    <span>Turn off</span>
                  </button>
                </div>
              </div>
            </div>

          </details>

        </div><!-- end vineyard_groups repeat -->
      </div>

    </div><!-- end section -->

    <!-- Close schedule modals — one per active schedule -->
    <div tal:repeat="group vineyard_groups">
      <div tal:repeat="row group.rows">
        <div tal:condition="row.active_schedule and row.is_irrigated" class="modal"
          id="close-modal-${row.active_schedule.id}">
          <div class="modal-background" onclick="this.parentElement.classList.remove('is-active')"></div>
          <div class="modal-card">
            <header class="modal-card-head">
              <p class="modal-card-title is-size-6">Turn off irrigation</p>
              <button class="delete" aria-label="close"
                onclick="this.closest('.modal').classList.remove('is-active')"></button>
            </header>
            <section class="modal-card-body">
              <p class="mb-3">
                Turn off <strong>${row.management_unit.name}</strong>
                (${row.active_schedule.schedule_summary})?
              </p>
              <form action="/irrigation/schedule/${row.active_schedule.id}/close" method="post">
                <div class="field">
                  <label class="label">Effective until</label>
                  <div class="control">
                    <input class="input" type="date" name="effective_until" required />
                  </div>
                  <p class="help">The date the controller was turned off.</p>
                </div>
                <div class="buttons mt-3">
                  <button type="submit" class="button is-warning">
                    <span class="icon"><i class="fas fa-stop-circle"></i></span>
                    <span>Confirm</span>
                  </button>
                  <button type="button" class="button is-light"
                    onclick="this.closest('.modal').classList.remove('is-active')">
                    Cancel
                  </button>
                </div>
              </form>
            </section>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>